{
  "uid": "timeflow",
  "title": "TimeFlow",
  "tags": [
    "timeflow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 12,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "hide": 0,
        "includeAll": false,
        "label": "登录账号",
        "multi": false,
        "name": "username",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          }
        ],
        "query": "All : .*",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [

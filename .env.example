POSTGRES_DB=timeapp
POSTGRES_USER=timeapp
POSTGRES_PASSWORD=timeapp
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
API_HOST=0.0.0.0
API_PORT=8000
TIMEFLOW_ENVIRONMENT=development
# Generate a private value of at least 32 UTF-8 bytes before starting the API.
TIMEFLOW_JWT_SECRET=
# 访问令牌有效期（秒），默认一个月（30 天）。
TIMEFLOW_JWT_ACCESS_TTL_SECONDS=2592000
TIMEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 云上同一台机器跑 API 时填真实语音密钥；非 development 必须配置，否则 /ws 拒绝启动。
TIMEFLOW_VOICE_AGENT_MODE=1
TIMEFLOW_ALIYUN_AUDIO_API_KEY=
TIMEFLOW_ALIYUN_AUDIO_WORKSPACE_ID=
TIMEFLOW_OPENAI_BASE_URL=
TIMEFLOW_OPENAI_API_KEY=
TIMEFLOW_OPENAI_MODEL=qwen3.6-flash
TIMEFLOW_TENCENT_MAP_KEY=

# 同一台机器跑 Grafana / Prometheus / Tempo 时：
# docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d --build
# 云上建议：API_HOST=127.0.0.1  POSTGRES_HOST=127.0.0.1  TIMEFLOW_ENVIRONMENT=production
GRAFANA_HOST=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://127.0.0.1:3000
SENTRY_AUTH_TOKEN=
TIMEFLOW_OTEL_SERVICE_NAME=timeflow-backend
TIMEFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=

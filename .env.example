POSTGRES_DB=timeapp
POSTGRES_USER=timeapp
POSTGRES_PASSWORD=timeapp
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
API_HOST=0.0.0.0
API_PORT=8000
TIMEFLOW_ENVIRONMENT=development
# Generate a private value of at least 32 UTF-8 bytes before starting the API.
TIMEFLOW_JWT_SECRET=
# 访问令牌有效期（秒），默认一个月（30 天）。
TIMEFLOW_JWT_ACCESS_TTL_SECONDS=2592000
TIMEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 云上同一台机器跑 API 时填真实语音密钥；非 development 必须配置，否则 /ws 拒绝启动。
TIMEFLOW_VOICE_AGENT_MODE=1
TIMEFLOW_ALIYUN_AUDIO_API_KEY=
TIMEFLOW_ALIYUN_AUDIO_WORKSPACE_ID=
TIMEFLOW_OPENAI_BASE_URL=
TIMEFLOW_OPENAI_API_KEY=
TIMEFLOW_OPENAI_MODEL=qwen3.6-flash
TIMEFLOW_TENCENT_MAP_KEY=

# 推到 main 后 CI 会写入 ghcr.io/1024xengineer/timeflow-backend 。云上不 --build 时用这个 tag。
TIMEFLOW_API_IMAGE_TAG=latest

# 观测栈：docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
# 云上建议：API_HOST=127.0.0.1  POSTGRES_HOST=127.0.0.1  TIMEFLOW_ENVIRONMENT=production
# 完整步骤见 observability/README.md
GRAFANA_HOST=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 浏览器打开 Grafana 的完整 URL。SSH 隧道用下面这一行。
GRAFANA_ROOT_URL=http://127.0.0.1:3000
# 与 API 同一个 HTTPS 域名、走 /grafana/ 时改成（末尾斜杠必须有）：
# GRAFANA_ROOT_URL=https://api.example.com/grafana/
# GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_SERVER_SERVE_FROM_SUB_PATH=false
# 装不上 Sentry 插件时保留这一行并设成空（Compose 会尊重空值，不要删掉变量名）：
GF_INSTALL_PLUGINS=grafana-sentry-datasource
# Grafana 读 sentry.io 用的 Auth Token（不是 App 的 DSN）。组织 slug 见 datasources/sentry.yml。
SENTRY_AUTH_TOKEN=
TIMEFLOW_OTEL_SERVICE_NAME=timeflow-backend
# 使用观测 overlay 时可不填，默认 http://tempo:4318 。不跑 Tempo 时保持空。
TIMEFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=

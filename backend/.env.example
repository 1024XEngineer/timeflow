TIMEFLOW_APP_NAME=TimeFlow API
TIMEFLOW_ENVIRONMENT=development
TIMEFLOW_DATABASE_URL=postgresql+psycopg://timeapp:timeapp@127.0.0.1:5432/timeapp

# Expo Web development origins. Use an explicit comma-separated allowlist in each environment.
TIMEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# WebSocket transport limits. Durations are expressed in seconds or milliseconds as named.
TIMEFLOW_WS_HANDSHAKE_TIMEOUT_SECONDS=5.0
TIMEFLOW_WS_MAX_UNAUTHENTICATED_CONNECTIONS=100
TIMEFLOW_WS_AUDIO_QUEUE_MAX_CHUNKS=32
TIMEFLOW_WS_MAX_AUDIO_DURATION_MS=120000
# push_to_talk uses the budget above, sized for one press-and-hold; continuous mode has
# no such bound and can run for minutes, so it gets a separate, much larger budget.
TIMEFLOW_WS_MAX_CONTINUOUS_AUDIO_DURATION_MS=1800000

# JWT 认证。请在本地生成至少 32 个 UTF-8 字节的私有密钥。
TIMEFLOW_JWT_SECRET=
TIMEFLOW_JWT_ISSUER=timeflow-api
TIMEFLOW_JWT_AUDIENCE=timeflow-app
# 访问令牌有效期（秒），默认一个月（30 天）。
TIMEFLOW_JWT_ACCESS_TTL_SECONDS=2592000

# Qwen realtime ASR. Replace {WorkspaceId} locally and keep the API key out of Git.
TIMEFLOW_ALIYUN_ASR_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
TIMEFLOW_ALIYUN_ASR_API_KEY=
TIMEFLOW_ALIYUN_ASR_MODEL=qwen3-asr-flash-realtime
TIMEFLOW_ALIYUN_ASR_LANGUAGE=zh
# 语音活动检测灵敏度
TIMEFLOW_ALIYUN_ASR_VAD_THRESHOLD=0.9
TIMEFLOW_ALIYUN_ASR_VAD_SILENCE_DURATION_MS=700
TIMEFLOW_ALIYUN_ASR_CONNECT_TIMEOUT_SECONDS=10
TIMEFLOW_ALIYUN_ASR_FINISH_TIMEOUT_SECONDS=10

# Qwen OpenAI-compatible LLM. Replace {WorkspaceId} locally and never commit credentials.
# Empty endpoint/key values are allowed at startup; they are required only when the adapter is used.
TIMEFLOW_OPENAI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TIMEFLOW_OPENAI_API_KEY=
TIMEFLOW_OPENAI_MODEL=qwen3.6-flash
TIMEFLOW_OPENAI_TIMEOUT_SECONDS=30
# Schedule category is optional and fails fast without retrying the provider.
TIMEFLOW_SCHEDULE_CATEGORY_TIMEOUT_SECONDS=5

# Maximum serial Function Calling rounds allowed during one Agent turn.
TIMEFLOW_AGENT_MAX_TOOL_ROUNDS=4

# Qwen-Audio-TTS raw WebSocket API. Replace {WorkspaceId} locally and keep the key secret.
# Empty endpoint/key values are allowed at startup; they are required only when TTS is used.
TIMEFLOW_ALIYUN_TTS_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
TIMEFLOW_ALIYUN_TTS_API_KEY=
TIMEFLOW_ALIYUN_TTS_MODEL=qwen-audio-3.0-tts-flash
TIMEFLOW_ALIYUN_TTS_VOICE=longanhuan_v3.6
TIMEFLOW_ALIYUN_TTS_CONNECT_TIMEOUT_SECONDS=10
TIMEFLOW_ALIYUN_TTS_TASK_TIMEOUT_SECONDS=30

# Aliyun Qwen-Audio realtime (end-to-end: audio in, speech out)
# Endpoint is built as {WORKSPACE_ID}.{REGION}.maas.aliyuncs.com, so no URL to set.
# Leave API_KEY or WORKSPACE_ID empty and the stand-in agent is used instead.
TIMEFLOW_ALIYUN_AUDIO_API_KEY=
TIMEFLOW_ALIYUN_AUDIO_WORKSPACE_ID=
TIMEFLOW_ALIYUN_AUDIO_MODEL=qwen-audio-3.0-realtime-plus
TIMEFLOW_ALIYUN_AUDIO_REGION=cn-beijing
TIMEFLOW_ALIYUN_AUDIO_VOICE=longanqian
# Server-side VAD backing continuous voice mode; push-to-talk ignores these. The client
# only ever picks push_to_talk vs continuous -- which vendor VAD backs continuous is ours
# to tune without a client release.
TIMEFLOW_ALIYUN_AUDIO_TURN_DETECTION=smart_turn
TIMEFLOW_ALIYUN_AUDIO_VAD_THRESHOLD=0.5
TIMEFLOW_ALIYUN_AUDIO_VAD_SILENCE_DURATION_MS=800

# Tencent Maps WebService. Keep the real key only in backend/.env or secret storage.
# The standalone location module is not wired into an Agent yet.
TIMEFLOW_TENCENT_MAP_KEY=
TIMEFLOW_TENCENT_MAP_BASE_URL=https://apis.map.qq.com
TIMEFLOW_TENCENT_MAP_TIMEOUT_SECONDS=5

# Which voice agent backend /ws uses: "1" = end-to-end realtime model (above),
# "2" = ASR + LLM + TTS conversation pipeline (requires ASR, OpenAI-compatible LLM, and TTS).
TIMEFLOW_VOICE_AGENT_MODE=1

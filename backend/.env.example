TIMEFLOW_APP_NAME=TimeFlow API
TIMEFLOW_ENVIRONMENT=development
TIMEFLOW_DATABASE_URL=postgresql+psycopg://timeapp:timeapp@127.0.0.1:5432/timeapp
TIMEFLOW_WS_HANDSHAKE_TIMEOUT_SECONDS=5.0
TIMEFLOW_WS_MAX_UNAUTHENTICATED_CONNECTIONS=100
TIMEFLOW_WS_AUDIO_QUEUE_MAX_CHUNKS=32
TIMEFLOW_WS_MAX_AUDIO_DURATION_MS=120000

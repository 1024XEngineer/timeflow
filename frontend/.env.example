# Android emulator: 10.0.2.2 reaches the host machine.
# Expo Web should use 127.0.0.1 instead.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws
EXPO_PUBLIC_DEVICE_ID=device_001

# Set to 1 to browse login and calendar without a backend (Vercel / Appetize previews).
# EXPO_PUBLIC_MOCK_MODE=1

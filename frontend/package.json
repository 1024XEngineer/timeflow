{
  "name": "timeflow-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=20.20.2 <21",
    "npm": ">=10.8.2 <11"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@irvingouj/expo-audio-stream": "3.1.0",
    "expo": "~57.0.7",
    "expo-location": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:vitest && npm run test:jest",
    "test:jest": "jest --runInBand",
    "test:jest:coverage": "jest --runInBand --coverage --coverageDirectory=coverage/jest",
    "test:auth:live": "jest --runInBand --env=node --runTestsByPath tests/integration/authBackend.live.ts --testMatch \"**/tests/integration/authBackend.live.ts\"",
    "test:vitest": "vitest run tests --exclude \"tests/unit/**\" --exclude \"tests/integration/**/*.integration.test.ts\"",
    "test:vitest:coverage": "vitest run tests --exclude \"tests/unit/**\" --exclude \"tests/integration/**/*.integration.test.ts\" --coverage --coverage.reportsDirectory=coverage/vitest --coverage.reporter=lcov --coverage.reporter=text",
    "test:coverage": "npm run test:vitest:coverage && npm run test:jest:coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "postinstall": "patch-package",
    "verify:ci": "npm run check && expo export --platform android --output-dir dist"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests/unit",
      "<rootDir>/tests/integration"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.[jt]s?(x)",
      "**/tests/integration/**/*.integration.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@irvingouj))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}

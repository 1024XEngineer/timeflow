{
  "name": "timeflow-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=20.20.2 <21",
    "npm": ">=10.8.2 <11"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "expo": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-location": "~57.0.9",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "57.0.2",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:vitest && npm run test:jest",
    "test:jest": "jest --runInBand",
    "test:vitest": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  }
